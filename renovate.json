{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>pedorich-n/renovate-config"],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "description": "Container image in terraform template",
      "managerFilePatterns": ["/^terraform/files/container\\.json$/"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "{ \"depName\": image, \"packageName\": image , \"currentValue\": version,  \"registryUrl\": \"https://\" & (registry = \"docker.io\" ? \"index.docker.io\" : registry),  \"versioning\": versioning, \"currentDigest\": digest }"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [ "docker" ],
      "matchPackageNames": [ "mic92/niks3" ],
      "sourceUrl": "https://github.com/mic92/niks3"
    }
  ]
}
